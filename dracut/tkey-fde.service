[Unit]
Description=TKey FDE Unlock
DefaultDependencies=no
Before=systemd-cryptsetup@luks\x2d8fc37b8b\x2d57dd\x2d4bb8\x2da633\x2d0d02003dd3e3.service
Before=cryptsetup.target
After=dev-ttyACM0.device
After=dev-nvme0n1p3.device
Wants=dev-ttyACM0.device

[Service]
Type=oneshot
ExecStart=/usr/bin/host
RemainAfterExit=yes
TimeoutStartSec=120

[Install]
WantedBy=cryptsetup.target
